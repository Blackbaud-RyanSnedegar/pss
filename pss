#!/usr/bin/env python3

import os
import sys
import argparse


def get_memory_sizes(pid):
    """Retrieve the Pss, Vss, and Rss sizes for a given PID."""
    sizes = {"Pss": None, "Vss": None, "Rss": None}
    try:
        with open(f"/proc/{pid}/smaps_rollup", "r") as f:
            for line in f:
                if line.startswith("Pss:"):
                    sizes["Pss"] = int(line.split()[1])  # Pss in kB
                elif line.startswith("Rss:"):
                    sizes["Rss"] = int(line.split()[1])  # Rss in kB
                elif line.startswith("VmSize:"):
                    sizes["Vss"] = int(line.split()[1])  # Vss in kB
    except FileNotFoundError:
        return None  # Process may no longer exist
    except Exception as e:
        sys.stderr.write(f"Error reading memory sizes for PID {pid}: {e}\n")
        return None
    return sizes


def find_pids_by_name(name):
    """Find PIDs matching a given process name."""
    pids = []
    for pid in os.listdir("/proc"):
        if pid.isdigit():
            try:
                with open(f"/proc/{pid}/comm", "r") as f:
                    if name in f.read().strip():
                        pids.append(int(pid))
            except FileNotFoundError:
                continue  # Process may no longer exist
            except Exception as e:
                sys.stderr.write(f"Error reading process name for PID {pid}: {e}\n")
    return pids


def main():
    parser = argparse.ArgumentParser(description="Retrieve memory sizes (Pss, Vss, Rss) for processes.")
    parser.add_argument("input", help="Comma-separated PIDs or process name")
    parser.add_argument("-v", "--vss", action="store_true", help="Include Vss (Virtual Set Size) in output")
    parser.add_argument("-r", "--rss", action="store_true", help="Include Rss (Resident Set Size) in output")
    args = parser.parse_args()

    input_arg = args.input
    if input_arg.isdigit() or " " in input_arg:
        # Input is a list of PIDs
        pids = [int(pid) for pid in input_arg.split(" ") if pid.isdigit()]
    else:
        # Input is a process name
        pids = find_pids_by_name(input_arg)

    if not pids:
        print("No matching PIDs found.")
        sys.exit(1)

    headers = ["PID", "Pss"]
    if args.vss:
        headers.append("Vss")
    if args.rss:
        headers.append("Rss")
    print("\t".join(headers))

    for pid in pids:
        sizes = get_memory_sizes(pid)
        if sizes:
            row = [str(pid), f"{sizes['Pss']}kb"]
            if args.vss:
                row.append(f"{sizes['Vss']}kb" if sizes["Vss"] is not None else "N/A")
            if args.rss:
                row.append(f"{sizes['Rss']}kb" if sizes["Rss"] is not None else "N/A")
            print("\t".join(row))


if __name__ == "__main__":
    main()
